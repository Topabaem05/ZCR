{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zcr.invalid/contracts/data.schema.json",
  "$defs": {
    "read": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Relative UTF-8 path; byte length<=4096 and OS limit enforced at runtime; no .., absolute, NUL, or policy escape."
        },
        "lines": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object",
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              },
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "end": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9223372036854775807
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "number",
              "start",
              "end",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "version": {
          "type": "object",
          "properties": {
            "size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "file_id": {
              "type": "string"
            },
            "sha256": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "size",
            "file_id",
            "sha256"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "path",
        "lines",
        "version"
      ],
      "additionalProperties": false
    },
    "files": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Relative UTF-8 path; byte length<=4096 and OS limit enforced at runtime; no .., absolute, NUL, or policy escape."
          }
        },
        "order": {
          "enum": [
            "discovery",
            "path_then_offset"
          ]
        }
      },
      "required": [
        "paths",
        "order"
      ],
      "additionalProperties": false
    },
    "search": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "description": "Relative UTF-8 path; byte length<=4096 and OS limit enforced at runtime; no .., absolute, NUL, or policy escape."
              },
              "matches": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9223372036854775807
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9223372036854775807
                    },
                    "line": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4294967295
                    }
                  },
                  "required": [
                    "start",
                    "end",
                    "line"
                  ],
                  "additionalProperties": false
                }
              },
              "context": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "number": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4294967295
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9223372036854775807
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9223372036854775807
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "number",
                    "start",
                    "end",
                    "text"
                  ],
                  "additionalProperties": false
                }
              },
              "version": {
                "type": "object",
                "properties": {
                  "size": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  },
                  "file_id": {
                    "type": "string"
                  },
                  "sha256": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "size",
                  "file_id",
                  "sha256"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "path",
              "matches",
              "context",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "order": {
          "enum": [
            "discovery",
            "path_then_offset"
          ]
        }
      },
      "required": [
        "files",
        "order"
      ],
      "additionalProperties": false
    },
    "batch_read": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "item_id": {
                "type": "string"
              },
              "ok": {
                "type": "boolean"
              },
              "data": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096,
                        "description": "Relative UTF-8 path; byte length<=4096 and OS limit enforced at runtime; no .., absolute, NUL, or policy escape."
                      },
                      "lines": {
                        "type": "array",
                        "maxItems": 5000,
                        "items": {
                          "type": "object",
                          "properties": {
                            "number": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 4294967295
                            },
                            "start": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9223372036854775807
                            },
                            "end": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9223372036854775807
                            },
                            "text": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "number",
                            "start",
                            "end",
                            "text"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "version": {
                        "type": "object",
                        "properties": {
                          "size": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9223372036854775807
                          },
                          "file_id": {
                            "type": "string"
                          },
                          "sha256": {
                            "oneOf": [
                              {
                                "type": "string",
                                "pattern": "^[0-9a-f]{64}$"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "size",
                          "file_id",
                          "sha256"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "path",
                      "lines",
                      "version"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "error": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "code": {
                        "enum": [
                          "E_INVALID_ARGUMENT",
                          "E_SCOPE",
                          "E_PATH_ESCAPE",
                          "E_UNSUPPORTED",
                          "E_NOT_FOUND",
                          "E_NOT_REGULAR",
                          "E_VERSION_CONFLICT",
                          "E_LEASE",
                          "E_FENCE",
                          "E_BUSY",
                          "E_RESOURCE",
                          "E_OUTPUT_BUDGET",
                          "E_CANCELLED",
                          "E_DEADLINE",
                          "E_IO",
                          "E_DURABILITY",
                          "E_RECOVERY_REQUIRED",
                          "E_INTERNAL"
                        ]
                      },
                      "message": {
                        "type": "string",
                        "maxLength": 4096
                      },
                      "retryable": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "code",
                      "message",
                      "retryable"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "item_id",
              "ok",
              "data",
              "error"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "items"
      ],
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "properties": {
        "receipt_id": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "applied": {
          "type": "boolean"
        },
        "durable": {
          "type": "boolean"
        },
        "cancellation_observed": {
          "type": "boolean"
        },
        "old_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "new_sha256": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "receipt_id",
        "idempotency_key",
        "applied",
        "durable",
        "cancellation_observed",
        "old_sha256",
        "new_sha256",
        "generation"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "index_state": {
          "type": "string"
        },
        "write_mode": {
          "enum": [
            "read_only",
            "dedicated_managed",
            "proposal_only"
          ]
        },
        "receipt": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "receipt_id": {
                  "type": "string"
                },
                "idempotency_key": {
                  "type": "string"
                },
                "applied": {
                  "type": "boolean"
                },
                "durable": {
                  "type": "boolean"
                },
                "cancellation_observed": {
                  "type": "boolean"
                },
                "old_sha256": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "new_sha256": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "generation": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9223372036854775807
                }
              },
              "required": [
                "receipt_id",
                "idempotency_key",
                "applied",
                "durable",
                "cancellation_observed",
                "old_sha256",
                "new_sha256",
                "generation"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "task_id",
        "index_state",
        "write_mode",
        "receipt"
      ],
      "additionalProperties": false
    },
    "health": {
      "type": "object",
      "properties": {
        "build_version": {
          "type": "string"
        },
        "backend": {
          "type": "string"
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "tracked_limit_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "tracked_live_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "pressure": {
          "enum": [
            "normal",
            "soft",
            "warning",
            "critical",
            "recovery",
            "unknown"
          ]
        },
        "usable_cpu_permits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        }
      },
      "required": [
        "build_version",
        "backend",
        "capabilities",
        "tracked_limit_bytes",
        "tracked_live_bytes",
        "pressure",
        "usable_cpu_permits"
      ],
      "additionalProperties": false
    }
  }
}
