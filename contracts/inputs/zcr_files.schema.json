{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "glob": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "default": "**/*"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "default": 1000
    },
    "include_hidden": {
      "type": "boolean",
      "default": false
    },
    "order": {
      "enum": [
        "discovery",
        "path_then_offset"
      ],
      "default": "discovery"
    },
    "consistency": {
      "type": "string",
      "enum": [
        "checked_live",
        "managed_generation",
        "bounded_stale"
      ],
      "default": "checked_live",
      "description": "Other modes are not exposed by v1 input; managed/stale require enabled capability and explicit policy."
    },
    "max_stale_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60000,
      "default": 0
    },
    "output_bytes": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 2097152,
      "default": 262144
    },
    "deadline_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60000,
      "default": 5000
    }
  },
  "required": [],
  "additionalProperties": false
}
